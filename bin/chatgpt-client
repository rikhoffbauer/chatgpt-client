#!/bin/sh
set -eu

SCRIPT="$0"
if command -v realpath >/dev/null 2>&1; then
  SCRIPT="$(realpath "$SCRIPT")"
fi
ROOT="$(CDPATH= cd -- "$(dirname -- "$SCRIPT")/.." && pwd)"

case "${npm_execpath:-}" in
  *bun*)
    exec bun "$ROOT/src/bin.ts" "$@"
    ;;
  *)
    exec node --import=tsx "$ROOT/src/bin.ts" "$@"
    ;;
esac
