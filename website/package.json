{
  "name": "chatgpt-client-website",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "check:boundary": "node --test test/*.test.mjs && node scripts/check-public-docs.mjs",
    "check": "npm run check:boundary && rm -rf .astro dist src/content/docs/api && astro check && astro build",
    "build": "npm run check:boundary && rm -rf .astro dist src/content/docs/api && astro build",
    "serve": "astro preview"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/starlight": "^0.37.6",
    "@types/node": "25.1.0",
    "astro": "^5.18.2",
    "starlight-copy-button": "https://github.com/dionysuzx/starlight-copy-button/archive/d570fcab6824127f80076eb419f39fb4fbd9de09.tar.gz",
    "starlight-dot-md": "^0.2.1",
    "starlight-links-validator": "^0.19.0",
    "starlight-llms-txt": "^0.7.0",
    "starlight-typedoc": "^0.21.0",
    "typedoc": "^0.28.20",
    "typescript": "5.8.3"
  }
}
