# Authentication and endpoints
# CODEX_AUTH_PATH="$HOME/.codex/auth.json"
# CODEX_API_BASE_URL="https://chatgpt.com/backend-api"
# CODEX_BIN="/Applications/ChatGPT.app/Contents/Resources/codex"

# Retry policy
CHATGPT_CLIENT_RETRY_ATTEMPTS=3
CHATGPT_CLIENT_RETRY_BASE_MS=250
CHATGPT_CLIENT_RETRY_MAX_MS=5000

# Deadlines
CHATGPT_CLIENT_REQUEST_TIMEOUT_MS=60000
CHATGPT_CLIENT_CONNECT_TIMEOUT_MS=15000

# Resource limits
CHATGPT_CLIENT_RESPONSE_BYTES=8388608
CHATGPT_CLIENT_STREAM_LINE_BYTES=2097152
CHATGPT_CLIENT_STREAM_EVENT_BYTES=8388608
CHATGPT_CLIENT_QUEUE_SIZE=1024
CHATGPT_CLIENT_UPLOAD_BYTES=536870912
CHATGPT_CLIENT_DOWNLOAD_BYTES=536870912
