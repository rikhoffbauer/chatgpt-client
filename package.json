{
  "name": "chatgpt-desktop-client",
  "version": "1.0.0",
  "description": "Unofficial typed client for the ChatGPT desktop protocol and local Codex app-server",
  "type": "module",
  "private": true,
  "bin": {
    "chatgpt-desktop-client": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/",
    "docs/",
    "scripts/",
    ".env.example",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && chmod +x dist/bin.js",
    "check": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist .test-dist coverage",
    "dev": "bun --watch src/bin.ts",
    "start": "node --enable-source-maps dist/bin.js",
    "test": "npm run test:node",
    "test:bun": "bun test",
    "test:node": "rm -rf .test-dist && tsc -p tsconfig.test.json && node --test --enable-source-maps .test-dist/test/*.test.js",
    "verify": "npm run check && npm run clean && npm run build && npm run test:node",
    "prepack": "npm run verify"
  },
  "devDependencies": {
    "@types/node": "25.1.0",
    "typescript": "5.8.3"
  }
}
